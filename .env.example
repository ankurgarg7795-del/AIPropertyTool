# ---- Backend -------------------------------------------------------------
APT_ENV=dev                   # dev | test | prod  (prod refuses insecure defaults)
APT_DEV_OTP_IN_RESPONSE=true  # local only: show the login code on screen instead of texting it
DATABASE_URL=                 # empty -> in-memory store; e.g. postgresql://postgres:postgres@localhost:5432/aiproperty
APT_AUTO_MIGRATE=true
APT_MEDIA_DIR=./var/media
APT_JWT_SECRET=               # required in prod: `python -c "import secrets;print(secrets.token_urlsafe(48))"`
ANTHROPIC_API_KEY=            # leave empty to run in offline heuristic mode
APT_LLM_MODEL=claude-opus-5-5
APT_LLM_EFFORT=medium
APT_LLM_SERVER_FALLBACKS=true # server-side refusal fallbacks (Claude API only)
APT_EMBEDDER=hashing          # or sentence-transformers (BAAI/bge-m3)
APT_SEED_DEMO_DATA=true
APT_CORS_ORIGINS=http://localhost:3000
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=          # required in prod: verifies X-Hub-Signature-256

# ---- Frontend ------------------------------------------------------------
BACKEND_URL=http://localhost:8000
