# Backend
ANTHROPIC_API_KEY=            # leave empty to run in offline heuristic mode
APT_LLM_MODEL=claude-opus-5-5
APT_LLM_EFFORT=medium
APT_LLM_SERVER_FALLBACKS=true # server-side refusal fallbacks (Claude API only)
APT_EMBEDDER=hashing          # or sentence-transformers (BAAI/bge-m3)
APT_SEED_DEMO_DATA=true
APT_CORS_ORIGINS=http://localhost:3000
WHATSAPP_VERIFY_TOKEN=change-me

# Frontend
BACKEND_URL=http://localhost:8000
